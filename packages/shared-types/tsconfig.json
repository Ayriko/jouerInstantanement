{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2021",
    "outDir": "./dist",
    "baseUrl": "./",
    "composite": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "noEmit": false,
  },
  "include": [
    "src/**/*"
  ]
}
