generator client {
  provider = "prisma-client"
  output   = "./src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Game {
  id              String   @id @default(uuid())
  name            String
  backgroundImage String
  rating          Float
  platforms       String[]
  genres          String[]
  tags            String[]
  screenshots     String[]
}
