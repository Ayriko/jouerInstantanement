{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "passWithNoTests": true,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@repo/)"
  ],
  "moduleNameMapper": {
    "^@repo/(.+)$": "<rootDir>/../../../packages/$1/src"
  }
}
