{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["test-results/**"]
    }
  },
  "globalEnv": [
      "DATABASE_URL",
      "POSTGRES_HOST",
      "POSTGRES_PORT",
      "POSTGRES_USER",
      "POSTGRES_PASSWORD",
      "POSTGRES_DB",
      "REDIS_HOST",
      "REDIS_PORT",
      "RABBITMQ_URL",
      "JWT_SECRET",
      "JWT_EXPIRES_IN",
      "JWT_REFRESH_EXPIRES_IN",
      "BETTER_AUTH_SECRET",
      "FRONTEND_URL",
      "GATEWAY_URL",
      "AUTH_SERVICE_URL",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "MAILJET_API_KEY",
      "MAILJET_SECRET_KEY",
      "MAIL_FROM",
      "MJ_TPL_USER_REGISTERED",
      "MJ_TPL_PURCHASE_INVOICE",
      "MJ_TPL_WISHLIST_RESTOCK"
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET"
  ]
}
